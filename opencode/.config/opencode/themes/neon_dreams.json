{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "accent",
      "purple",
      "green",
      "blue"
    ],
    "text": {
      "base": "#7dcfff",
      "muted": "#7a8fc4",
      "dim": "#4a5f8f",
      "link": "#5fc9e8",
      "code": "#66e8b5",
      "emphasis": "#c5d4ff",
      "strong": "#c5d4ff",
      "selected": "#5f9eff",
      "inverted": "#1a2642",
      "accent": "#ff5eb8",
      "error": "#ff6eb5",
      "warning": "#ffb366",
      "success": "#66e8b5",
      "info": "#5fc9e8",
      "action": {
        "primary": {
          "base": "#5fadff",
          "$hovered": "#7eb5ff",
          "$pressed": "#3d7acc",
          "$disabled": "#4a5f8f"
        },
        "secondary": {
          "base": "#5f9eff",
          "$hovered": "#7eb5ff",
          "$pressed": "#3d7acc",
          "$disabled": "#4a5f8f"
        },
        "destructive": {
          "base": "#ff668c",
          "$hovered": "#ff6eb5",
          "$pressed": "#ff668c",
          "$disabled": "#4a5f8f"
        }
      }
    },
    "background": {
      "base": "#1a2642",
      "raised": {
        "base": "#1e2d4d",
        "high": "#243556",
        "max": "#2a3d5f"
      },
      "panel": "#1e2d4d",
      "element": "#243556",
      "menu": "#1e2d4d",
      "input": "#1e2d4d",
      "success": "#1e2d4d",
      "warning": "#1e2d4d",
      "error": "#1e2d4d",
      "info": "#1e2d4d",
      "diff": "#1e2d4d"
    },
    "border": {
      "base": "#2a3550",
      "active": "#b366ff",
      "subtle": "#1e2d4d"
    },
    "scrollbar": {
      "base": "#4d5d8a",
      "track": "#1e2d4d"
    },
    "diff": {
      "added": "#66e8b5",
      "removed": "#ff668c",
      "context": "#7a8fc4",
      "hunkHeader": "#7a8fc4",
      "highlightAdded": "#66e8b5",
      "highlightRemoved": "#ff6eb5",
      "addedBg": "#1e2d4d",
      "removedBg": "#1e2d4d",
      "contextBg": "#1e2d4d",
      "lineNumber": "#4a5f8f",
      "addedLineNumberBg": "#1e2d4d",
      "removedLineNumberBg": "#1e2d4d"
    },
    "markdown": {
      "text": "#7dcfff",
      "heading": "#ff5eb8",
      "link": "#5fc9e8",
      "linkText": "#5fadff",
      "code": "#66e8b5",
      "blockQuote": "#4d5d8a",
      "emphasis": "#c5d4ff",
      "strong": "#c5d4ff",
      "horizontalRule": "#4d5d8a",
      "listItem": "#e066ff",
      "listEnumeration": "#e066ff",
      "image": "#5f9eff",
      "imageText": "#5fadff",
      "codeBlock": "#7a8fc4"
    },
    "syntax": {
      "comment": "#4d5d8a",
      "keyword": "#c576ff",
      "function": "#5fadff",
      "variable": "#7dcfff",
      "string": "#66e8b5",
      "number": "#e066ff",
      "type": "#7eb5ff",
      "operator": "#c5d4ff",
      "punctuation": "#7a8fc4"
    }
  },
  "dark": {
