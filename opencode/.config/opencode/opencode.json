{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "./plugins/rtk"
    }
  ],
  "mcp": {
    "servers": {
      "filesystem": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "."
        ]
      },
      "semble": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "semble[mcp]",
          "semble"
        ]
      },
      "mcp-dap-server": {
        "type": "local",
        "command": [
          "mcp-dap-server"
        ]
      },
      "atuin": {
        "type": "local",
        "command": [
          "/home/eryoma/.cargo/bin/atuin",
          "mcp"
        ]
      }
    }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "ty": {
      "command": [
        "ty",
        "server"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "autotools": {
      "command": [
        "autotools-language-server"
      ],
      "extensions": [
        ".ac"
      ]
    },
    "make-ls": {
      "command": [
        "make-ls"
      ],
      "extensions": [
        ".mk",
        "Makefile",
        "makefile"
      ]
    }
  },
  "formatter": true,
  "providers": {
    "llama": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "llama",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "timeout": false
      },
      "models": {
        "qwen": {
          "name": "qwen",
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low",
                "textVerbosity": "low",
                "reasoningSummary": "auto"
              }
            }
          ],
          "limit": {
            "context": 262144,
            "output": 65536
          }
        }
      }
    }
  }
}