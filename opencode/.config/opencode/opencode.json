{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@plannotator/opencode@latest",
    "@spoons-and-mirrors/subtask2@latest"
  ],
  "mcp": {
    "servers": {
      "filesystem": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "."
        ]
      },
      "semble": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "semble[mcp]",
          "semble"
        ]
      },
      "mcp-dap-server": {
        "type": "local",
        "command": [
          "mcp-dap-server"
        ]
      }
    }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py", ".pyi"]
    },
    "autotools": {
      "command": ["autotools-language-server"],
      "extensions": [".ac"]
    },
    "make-ls": {
      "command": ["make-ls"],
      "extensions": [".mk", "Makefile", "makefile"]
    }
  },
  "formatter": true,
  "agents": {
    "plan": {
      "model": "anthropic/claude-opus-5"
    },
    "build": {
      "model": "anthropic/claude-sonnet-5"
    }
  },
  "providers": {
    "anthropic": {
      "settings": {
        "baseURL": "https://claude-n-codex.com:8443/v1"
      }
    },
    "llama": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "llama",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "timeout": false
      },
      "models": {
        "qwen": {
          "name": "qwen",
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low",
                "textVerbosity": "low",
                "reasoningSummary": "auto"
              }
            }
          ],
          "limit": {
            "context": 262144,
            "output": 65536
          }
        }
      }
    }
  }
}
