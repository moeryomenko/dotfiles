{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@franlol/opencode-md-table-formatter@latest",
    "opencode-mem",
    "@plannotator/opencode@latest",
    "@spoons-and-mirrors/subtask2@latest",
    "./plugins/revdiff-plan-review.ts",
    "@prevalentware/opencode-goal-plugin",
    "/Users/eryoma/projects/tuicr-opencode-plugin/plugin/index.ts"
  ],
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "enabled": true
    },
    "semble": {
      "command": [
        "uvx",
        "--from",
        "semble[mcp]",
        "semble"
      ],
      "type": "local",
      "enabled": true
    },
    "mcp-dap-server": {
      "type": "local",
      "command": [
        "mcp-dap-server"
      ],
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py", ".pyi"]
    }
  },
  "formatter": true,
  "provider": {
    "gis": {
      "name": "2GIS",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://ai-dev-proxy.k8s.n3.2gis.io"
      },
      "models": {
        "coding-medium": {
          "name": "coding-medium"
        },
        "local-coding-medium": {
          "name": "local-coding-medium"
        },
        "coding-large": {
          "name": "coding-large"
        }
      }
    }
  }
}
