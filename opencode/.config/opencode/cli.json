{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight",
    "mode": "dark"
  },
  "plugins": [
    "@prevalentware/opencode-goal-plugin"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "markdown": "rendered"
  },
  "experimental": {
    "todo": true,
    "background_compaction": true,
    "new-designs": true,
    "client-mcp": true
  },
  "animations": true,
  "debug": {
    "devtools": true
  }
}
