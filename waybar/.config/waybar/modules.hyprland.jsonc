{
  "group/left": {
    "orientation": "horizontal",
    "modules": [
      "hyprland/workspaces",
      "mpris",
      "custom/mpv"
    ]
  },
  "group/left-hidden": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": false,
      "click-to-reveal": true
    },
    "modules": [
      "custom/arrow-right",
      "cpu",
      "load"
    ]
  },
  "group/left-hidden-top": {
    "orientation": "horizontal",
    "modules": [
      "power-profiles-daemon",
      "group/left-hidden"
    ]
  },
  "group/right": {
    "orientation": "horizontal",
    "modules": [
      "bluetooth",
      "custom/bluetooth-devices",
      "group/group-volume",
      "network",
      "tray"
    ]
  },
  "group/right-hidden": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": true,
      "click-to-reveal": true
    },
    "modules": [
      "custom/arrow-left",
      "memory",
      "temperature"
    ]
  },
  "group/right-hidden-top": {
    "orientation": "horizontal",
    "modules": [
      "group/right-hidden",
      "custom/ctlcenter"
    ]
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-scroll-down": "hyprctl dispatch \"hl.dsp.focus({workspace = 'e+1'}\")",
    "on-scroll-up": "hyprctl dispatch \"hl.dsp.focus({workspace = 'e-1'}\")",
    "persistent-workspaces": {
      "1": [
        "DP-1"
      ],
      "2": [
        "DP-1"
      ],
      "3": [
        "DP-1"
      ],
      "4": [
        "DP-1"
      ],
      "5": [
        "DP-1"
      ],
      "10": [
        "DP-2"
      ],
      "11": [
        "DP-2"
      ],
      "12": [
        "DP-2"
      ],
      "13": [
        "DP-2"
      ],
      "14": [
        "DP-2"
      ]
    },
    "cursor": true,
    "format-icons": {
      "active": "󰮯",
      "persistent": "",
      "empty": ""
    },
    "on-click": "activate"
  },
  "cpu": {
    "interval": 30,
    "format": " {usage}%",
    "cursor": true,
    "states": {
      "warning": 80,
      "critical": 90
    }
  },
  "tray": {
    "icon-size": 13,
    "spacing": 12,
    "cursor": true
  },
  "load": {
    "interval": 30,
    "format": " {load1}",
    "cursor": true
  },
  "memory": {
    "interval": 10,
    "format": "  {used:0.1f}G/{total:0.1f}G",
    "states": {
      "warning": 80,
      "critical": 90
    }
  },
  "temperature": {
    "interval": 10,
    "format": "{icon} {temperatureC}°",
    "critical-threshold": 90,
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "hwmon-by-name": "k10temp",
    "input-filename": "temp1_input"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-bluetooth": "{icon}",
    "tooltip-format": "{volume}%",
    "format-muted": "<span size='9.5pt'></span>",
    "scroll-step": 2,
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "<span size='9.5pt'></span>",
        "<span size='9.5pt'></span>",
        "<span size='9.5pt'></span>",
        "<span size='9.5pt'></span>"
      ]
    }
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "cursor": true,
    "on-click-right": "pavucontrol"
  },
  "network": {
    "interval": 10,
    "format-disabled": "",
    "format-disconnected": "",
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "tooltip-format": "{essid}\n\nFrequency: {frequency}GHz\nStrength: {signalStrength}%\n\n{bandwidthUpBytes}   {bandwidthDownBytes}",
    "tooltip-format-ethernet": "{bandwidthUpBytes}   {bandwidthDownBytes}",
    "tooltip-format-disconnected": "No network connection!",
    "tooltip-format-disabled": "No network connection!",
    "on-click": "~/.config/waybar/bin/toggle-wifi.sh",
    "menu": "on-click-right",
    "menu-file": "~/.config/waybar/context/network.xml",
    "menu-actions": {
      "action-1": "~/.config/waybar/bin/toggle-wifi.sh",
      "action-2": "ghostty -e nmtui",
      "action-3": "nm-connection-editor"
    }
  },
  "bluetooth": {
    "format": "{}",
    "format-on": "󰂰",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂯 {num_connections}",
    "format-connected-battery": "󰂯 {num_connections}",
    "tooltip-format": "{device_enumerate}",
    "tooltip-format-connected": "{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}   {device_battery_percentage}%",
    "on-click": "~/.config/waybar/bin/toggle_bluetooth",
    "on-click-right": "ghostty -e bluetoothctl"
  },
  "clock": {
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%H:%M %d %B %Y}",
    "calendar": {
      "mode": "year",
      "weeks-pos": "right",
      "mode-mon-col": 3,
      "format": {
        "months": "<span color='#acb0d0'><b>{}</b></span>",
        "weeks": "<span color='#7aa2f7'><b>W{}</b></span>",
        "weekdays": "<span color='#e0af68'><b>{}</b></span>",
        "days": "<span color='#acb0d0'><b>{}</b></span>",
        "today": "<span color='#41a6b5'><b><u>{}</u></b></span>"
      }
    }
  },
  "mpris": {
    "format": "{artist} - {title}",
    "tooltip-format": "{album}",
    "format-paused": " {artist} - {title}",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl previous",
    "on-scroll-down": "playerctl next",
    "max-length": 45
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}",
    "format-icons": {
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "custom/ctlcenter": {
    "tooltip": false,
    "format": "",
    "on-click": "~/.config/waybar/bin/ctlcenter.sh",
    "menu": "on-click-right",
    "menu-file": "~/.config/waybar/context/ctlcenter.xml",
    "menu-actions": {
      "action-1-1": "ghostty -e htop",
      "action-1-2": "ghostty -e btop",
      "action-1-3": "ghostty -e nvtop",
      "action-2": "hyprctl reload",
      "action-3": "hyprctl eval \"hl.exec_cmd('~/.config/waybar/waybar.sh')\""
    }
  },
  "custom/arrow-left": {
    "format": "",
    "tooltip": false,
    "cursor": true
  },
  "custom/arrow-right": {
    "format": "",
    "tooltip": false,
    "cursor": true
  },
  "group/group-volume": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 600,
      "transition-left-to-right": true,
      "reveal-delay": 450
    },
    "modules": [
      "pulseaudio",
      "pulseaudio/slider"
    ]
  },
  "custom/mpv": {
    "exec": "~/.config/waybar/bin/mpv-title.sh",
    "interval": 1,
    "format": "{}",
    "max-length": 40,
    "tooltip": false,
    "hide-empty-text": true
  },
  "custom/bluetooth-devices": {
    "exec": "~/.config/waybar/bin/bluetooth-devices.sh",
    "return-type": "json",
    "interval": 10,
    "format": "{}",
    "tooltip": true,
    "escape": true,
    "hide-empty-text": true
  }
}
