#!/bin/sh
# pinentry dispatcher for gpg-agent.
#
# gpg-agent requires an absolute path for pinentry-program and does not
# search PATH. The Homebrew path used on macOS does not exist on Linux
# (and vice versa), so gpg-agent.conf points here through ~/.gnupg and
# this wrapper execs the first pinentry available on the current machine.
#
# Set PINENTRY_PROGRAM to force a specific binary.

set -eu

if [ -n "${PINENTRY_PROGRAM:-}" ]; then
    exec "$PINENTRY_PROGRAM" "$@"
fi

for candidate in \
    /opt/homebrew/bin/pinentry-mac \
    /usr/local/bin/pinentry-mac \
    /usr/bin/pinentry-tty \
    /usr/bin/pinentry-curses \
    /usr/bin/pinentry-gnome3 \
    /usr/bin/pinentry \
    /opt/homebrew/bin/pinentry
do
    if [ -x "$candidate" ]; then
        exec "$candidate" "$@"
    fi
done

printf 'pinentry-wrapper: no pinentry found in known locations\n' >&2
exit 1
